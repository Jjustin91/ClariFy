{
  "name": "ustp-cdo/clarify-api",
  "type": "project",
  "description": "ClariFy — USTP Unified Campus Noticeboard & Scoped Communication Platform RESTful API (IT314 Group 5)",
  "keywords": ["laravel", "ustp", "clarify", "sanctum", "postgresql"],
  "license": "MIT",
  "require": {
      "php": "^8.2",
      "laravel/framework": "^12.0",
      "laravel/sanctum": "^4.0",
      "laravel/tinker": "^2.10"
  },
  "require-dev": {
    "fakerphp/faker": "^1.23",
    "laravel/pail": "^1.2",
    "laravel/pint": "^1.21",
    "laravel/sail": "^1.41",
    "mockery/mockery": "^1.6",
    "nunomaduro/collision": "^8.6",
    "phpunit/phpunit": "^11.5.3"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Database\\Factories\\": "database/factories/",
      "Database\\Seeders\\": "database/seeders/"
    }
  },
  "scripts": {
    "post-root-package-install": [
      "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
    ],
    "post-create-project-cmd": [
      "@php artisan key:generate --ansi"
    ]
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
