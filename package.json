{
  "name": "clarify-ustp-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "clarify-web"
  ],
  "scripts": {
    "dev": "cd clarify-web && exec ./node_modules/.bin/next dev -p 3000 -H 0.0.0.0",
    "build": "cd clarify-web && ./node_modules/.bin/next build",
    "start": "cd clarify-web && exec ./node_modules/.bin/next start -p 3000 -H 0.0.0.0",
    "lint": "cd clarify-web && ./node_modules/.bin/eslint .",
    "clean": "cd clarify-web && ./node_modules/.bin/next clean"
  },
  "dependencies": {
    "laravel-echo": "^2.6.3",
    "pg": "^8.23.1",
    "pusher-js": "^8.6.0"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1"
  }
}
