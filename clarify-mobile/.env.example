# ClariFy Mobile Public Environment Variables
# Copy to `.env` locally or configure in EAS Build environment variables (never commit `.env`).
# WARNING: All EXPO_PUBLIC_* values are embedded in the mobile app bundle and are PUBLIC.
# Never place private secrets, API keys, or service-account credentials here.

# Laravel API v1 base URL (always use the `api.` host, never `ustpclarify.tech/api/...`)
EXPO_PUBLIC_API_BASE_URL=https://api.ustpclarify.tech/api/v1

# Laravel Reverb public app key (must match REVERB_APP_KEY on the API server).
# If left blank on a non-local host, WebSocket realtime stays disabled and the app
# displays a visible "Live updates unavailable" banner instead of silently failing.
EXPO_PUBLIC_REVERB_APP_KEY=

# Laravel Reverb WebSocket host, port, and scheme (production enforces WSS on port 443 via nginx `/app`)
EXPO_PUBLIC_REVERB_HOST=api.ustpclarify.tech
EXPO_PUBLIC_REVERB_PORT=443
EXPO_PUBLIC_REVERB_SCHEME=https
