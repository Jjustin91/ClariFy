{
  "expo": {
    "name": "ClariFy",
    "slug": "clarify-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "clarifymobile",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.ustp.clarify",
      "icon": "./assets/images/icon.png"
    },
    "android": {
      "package": "com.ustp.clarify",
      "adaptiveIcon": {
        "backgroundColor": "#1a1851",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1a1851",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "ClariFy accesses your photo library so you can attach images to announcements and set your profile photo.",
          "cameraPermission": "ClariFy accesses your camera so you can take photos for announcements and your profile photo."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#fcb315",
          "defaultChannel": "urgent-alerts"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}